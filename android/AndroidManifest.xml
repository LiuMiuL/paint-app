<?xml version="1.0" encoding="utf-8"?>
<!-- 그림판 안드로이드 앱: 프로젝트의 웹 파일을 APK 안에 넣어 오프라인으로 실행한다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.liumiul.paint">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <application
        android:label="그림판"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <!-- 회전·폴드 펼침에도 화면을 새로 만들지 않는다 (새로 만들면 그리던 그림이 사라짐) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
